# Optional: Google Programmable Search JSON API (server only; never place secrets in public/)
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
PORT=3000
# Set only behind a proxy that strips untrusted forwarding headers:
TRUST_PROXY=false

# Phase 3: opt-in public HTTPS page reader. Default is OFF.
# Enable only in isolated development after reviewing outbound network policy.
WAE_READER_ENABLED=false

# Phase 4: vaults are OFF unless the reader is enabled AND valid tokens are configured.
# The value must be valid JSON with unique ASCII bearer tokens (minimum 32 chars).
# Example is deliberately not a working secret. Generate real secrets offline and never commit them:
# WAE_VAULTS_JSON={"team_alpha":"<unique-random-token-at-least-32-chars>"}
WAE_VAULTS_JSON=
# Keep on a persistent local disk with restricted OS access, never inside public/ or repository:
WAE_VAULT_DIR=.wae-private-vaults
# Remote access MUST terminate TLS and enforce additional network controls before sending bearer tokens.

# Phase 5: AES-256-GCM keys. Reader stays OFF unless this map covers ALL vault IDs exactly.
# Generate one independent 32-byte random key per vault OFFLINE; encode each as 64 hex characters.
# NEVER reuse the bearer token as the encryption key. Never commit real keys.
# WAE_VAULT_KEYS_JSON={"team_alpha":"<64-random-hex-characters>"}
WAE_VAULT_KEYS_JSON=
# Local encrypted backups (separate persistent folder; never under public/ or GitHub):
WAE_BACKUP_DIR=.wae-private-backups
