# Optional: Google Programmable Search JSON API (server only; never place secrets in public/)
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
PORT=3000
# Set only behind a proxy that strips untrusted forwarding headers:
TRUST_PROXY=false

# Phase 3: opt-in public HTTPS page reader. Default is OFF.
# Enable only in isolated development after reviewing outbound network policy.
WAE_READER_ENABLED=false

# Phase 4: vaults are OFF unless the reader is enabled AND valid tokens are configured.
# The value must be valid JSON with unique ASCII bearer tokens (minimum 32 chars).
# Example is deliberately not a working secret. Generate real secrets offline and never commit them:
# WAE_VAULTS_JSON={"team_alpha":"<unique-random-token-at-least-32-chars>"}
WAE_VAULTS_JSON=
# Keep on a persistent local disk with restricted OS access, never inside public/ or repository:
WAE_VAULT_DIR=.wae-private-vaults

# Optional durable PostgreSQL-backed encrypted vaults. OFF by default.
# Uses the same verified PostgreSQL URL+CA environment as the accounts store,
# but an independent table and AES key for each research vault.
WAE_VAULT_STORE=file
# With WAE_VAULT_STORE=postgres:
# 1. Configure WAE_ACCOUNTS_DATABASE_URL and WAE_ACCOUNTS_PG_CA (base64 CA PEM).
# 2. Keep WAE_READER_ENABLED=false until schema is initialized intentionally.
# 3. Run npm run vault:pg:init on an empty database after backup approval.
# NO automatic import of local vault files; never enable an empty DB over live vaults.
# File vaults are unavailable in Vercel functions. PostgreSQL is REQUIRED there.

# Remote access MUST terminate TLS and enforce additional network controls before sending bearer tokens.

# Phase 5: AES-256-GCM keys. Reader stays OFF unless this map covers ALL vault IDs exactly.
# Generate one independent 32-byte random key per vault OFFLINE; encode each as 64 hex characters.
# NEVER reuse the bearer token as the encryption key. Never commit real keys.
# WAE_VAULT_KEYS_JSON={"team_alpha":"<64-random-hex-characters>"}
WAE_VAULT_KEYS_JSON=
# Local encrypted backups (separate persistent folder; never under public/ or GitHub):
WAE_BACKUP_DIR=.wae-private-backups

# Phase 6: email/password accounts + private owner-only businesses are OFF by default.
# Use a distinct random AES-256 key, never reuse WAE_VAULT_KEYS_JSON or bearer tokens.
WAE_ACCOUNTS_ENABLED=false
# 64 random hex characters, generated outside the repository and environment logs:
WAE_ACCOUNTS_KEY=
# Persist on a private durable volume; DO NOT place inside public/ or the git repository.
WAE_ACCOUNTS_DIR=.wae-private-accounts

# Optional production-capable shared account record store (disabled by default).
# Modes: file (existing, SINGLE PROCESS + durable private disk) or postgres.
# PostgreSQL stores the SAME AES-256-GCM encrypted record in a row locked
# across instances; it does not import, erase or migrate any file records.
WAE_ACCOUNTS_STORE=file
# Required for postgres mode. Keep only in private server environment.
# Example format only; never put working credentials in the repository:
# WAE_ACCOUNTS_DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/DB_NAME
WAE_ACCOUNTS_DATABASE_URL=
# Base64 of the database server CA certificate PEM; verified TLS REQUIRED.
# e.g. base64 -w0 /secure/ca.pem (do not commit live certificates/secrets).
WAE_ACCOUNTS_PG_CA=
# NEVER set NODE_ENV=test or this flag in production. Test CI only,
# and only valid for loopback PostgreSQL.
WAE_POSTGRES_ALLOW_INSECURE_LOCAL_TEST=false
# Explicit schema operation, after backup and selecting postgres:
# npm run accounts:pg:init
# Existing file accounts will NOT appear automatically in PostgreSQL.


# Offline vault key rotation: supply a NEW random hex key only to the maintenance CLI.
# Keep previous key secured for the pre-rotation encrypted backup. Do not set in public hosting.
# WAE_VAULT_NEW_KEY=

# WAEWEB Connect API v1. OFF by default. Server-to-server only; NEVER NEXT_PUBLIC_.
# Once a secure WAEWEB runtime is deployed, provision a distinct random token
# (32-256 printable ASCII chars) to each of these three CLIENT IDs:
# inteligenciauniversal, universal-core-vt3h, waeosgreen.
# WAE_CONNECT_CLIENTS_JSON={"inteligenciauniversal":"<random-secret-A>","universal-core-vt3h":"<random-secret-B>","waeosgreen":"<random-secret-C>"}
WAE_CONNECT_ENABLED=false
WAE_CONNECT_CLIENTS_JSON=
# Public HTTPS Reader is a separate, opt-in feature. No document is saved in a vault by Connect.
WAE_CONNECT_READER_ENABLED=false
